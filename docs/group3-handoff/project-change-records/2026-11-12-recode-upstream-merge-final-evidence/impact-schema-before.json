{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/v2-concurrency/lock-race-impact-scope.schema.json",
  "title": "Deterministic lock/race blast radius",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "source_runs",
    "change_context",
    "roots",
    "functions",
    "call_edges",
    "shared_objects",
    "locks",
    "async_boundaries",
    "condition_variables",
    "lock_order_edges",
    "context_ids",
    "evidence_ids",
    "coverage",
    "stats"
  ],
  "properties": {
    "schema_version": {"const": "lock-race-impact-scope/0.1"},
    "repository": {"type": "object"},
    "source_runs": {"type": "object"},
    "change_context": {"type": "object"},
    "roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "name", "location", "distance", "reasons", "evidence_ids"],
        "properties": {
          "node_id": {"type": ["string", "null"]},
          "name": {"type": "string", "minLength": 1},
          "qualified_name": {"type": ["string", "null"]},
          "location": {"type": ["object", "null"]},
          "distance": {"type": ["integer", "null"], "minimum": 0},
          "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "call_edges": {"type": "array", "items": {"type": "object"}},
    "shared_objects": {"type": "array", "items": {"type": "object"}},
    "locks": {"type": "array", "items": {"type": "object"}},
    "async_boundaries": {"type": "array", "items": {"type": "object"}},
    "condition_variables": {"type": "array", "items": {"type": "object"}},
    "lock_order_edges": {"type": "array", "items": {"type": "object"}},
    "context_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "coverage": {
      "type": "object",
      "required": ["complete", "reason", "unresolved", "components"],
      "properties": {
        "complete": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "unresolved": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "components": {"type": "object"}
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": [
        "root_count",
        "function_count",
        "call_edge_count",
        "shared_object_count",
        "shared_access_count",
        "lock_count",
        "async_boundary_count",
        "condition_variable_count",
        "lock_order_edge_count"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
